	class BadgeRequest : ThumbnailRequest
	{
		private Roblox.IAsset _Badge;
		public override bool RequiresDeepModeration
		{
			get { return false; }
		}
		public override string TypeIdentifier
		{
			get { return "Badge"; }
		}
		public BadgeRequest(IAsset badge, ImageParameters imageParameters)
			: base(badge.AssetBadgeID, imageParameters)
		{
			_Badge = badge;
		}
		internal override Bitmap GenerateBitmap(ref ICollection<AssetReference> assetReferences)
		{
			AssetVersion currentVerion = _Badge.CurrentVersion;
			var assetBadgeOption = AssetBadgeOption.GetAssetBadgeOption.LookupFilter.AssetID, currentVersion.AssetID);
			var badgeImageAsset = Roblox.Asset.Get(assetBadgeOption.BadgeImageID);
			var badgeImageAssetReference = new AssetReference(badgeImageAsset, AssetReference.AssetReferenceTypes.AssetSubscription);
			assetReferences.Add(badgeImageAssetReference);
			var scaledBitmap = new Bitmap(ImageParameters.Width, ImageParameters.Height, PixelFormat.Format32bppArgb);
			if (!badgeImageAsset.IsReviewed)
			{
				using (Bitmap bitmap = Dispatcher.Singleton.CreatePendingReviewBitmap(ImageParameters.Width, ImageParameters.Height)
				{
					Thumbnails.DrawInto(bitmap, scaledBitmap);
				}
			}
			else if (!_Badge.IsApproved || !badgeImageAsset.IsApproved)
			{
				using (Bitmap bitmap = Dispatcher.Singleton.CreateUnapprovedBitmap(ImageParameters.Width, ImageParameters.Height))
				{
					Thumbnails.DrawInto(bitmap, scaledBitmap);
				}
			}
			else
			{
				using (MemoryStream memoryStream = FilesManager.Singleton.GetStream(badgeImageAsset.Hash))
				{
					using (var image = Image.FromStream(memoryStream))
					{
						Thumbnails.DrawInto(image, scaledBitmap);
					}
				}
			}
			return scaledBitmap;
		}
	}
	class ImageRequest : ThumbnailRequest
