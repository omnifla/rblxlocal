<?php
// ported by meditext
namespace Roblox\Thumbs;
/// This script is responsible for the /Thumbs/Asset.ashx and other parts known so far that renders the Thumbnail.
use Roblox\Data;
use Roblox\Grid;
use Roblox\Grid\Rcc;
use Roblox\Grid\Lua;

/// Creates Asset thumbnails and provides Urls to the thumbnails
/// This web service is coupled with AssetImage.js and the AssetImage control

abstract class BodyPartRequest {
	protected override GridRequest.JobCategory Category
	{
		get { return JobCategory.FastJob; }
	}
	protected virtual long CustomTextureAssetID
	{
		get { return -1; }
	}
	protected string script
	{
		get
		{
			string val = string.Empty;
			if (!string.IsNullOrEmpty(Properties.Settings.Default.BodyPartScriptOverride))
				val = Properties.Settings.Default.BodyPartScriptOverride;
			else
				val = _BodyPartScript;
			return val;
		}
	}
	public override bool RequiresDeepModeration
	{
		get { return false; }
	}
	public BodyPartRequest(long assetHashId, ImageParameters imageParameters)
		: base(assetHashId, imageParameters)
	{
	}
	protected override ScriptExecution GetScript(Size size)
	{
		string customTextureUrl = _AssetRequest + CustomTextureAssetID;
		return Lua.NewScript(
			Key,
			script,
			AssetHashUrl,
			_Url,
			ImageParameters.FileExtension,
			size.Width,
			size.Height,
			_MannequinUrl,
			customTextureUrl
		);
	}
}
class Asset {
    private static $accessKeyParameter;
    private static $assetHashRequest;
    private static $assetRequest;
    private static $assetVersionRequest;
    private static $bodyPartScript;
    private static $decalScript;
    private static $faceScript;
    private static $gearScript;
    private static $headScript;
    private static $hatScript;
    private static $mannequinId = 1785197;
    private static $mannequinUrl;
    private static $modelScript;
    private static $packageScript;
    private static $pantsScript;
    private static $placeScript;
    private static $scriptPngPath;
    private static $shirtScript;
    private static $toolPngPath;
    private static $url;

    public static function init() {
        self::$accessKeyParameter   = "&accesskey=" . \Roblox\Common\Web::getAccessKey();
        self::$assetHashRequest     = \Roblox\Common\Web::getApplicationURL() . "/Asset/?hash=";
        self::$assetRequest         = \Roblox\Common\Web::getApplicationURL() . "/Asset/?id=";
        self::$assetVersionRequest  = \Roblox\Common\Web::getApplicationURL() . "/Asset/?versionid=";
        // TODO: load resources instead of Resources.Roblox_Thumbs_* from C#
        self::$bodyPartScript       = file_get_contents(__DIR__ . "/BodyPartScript.lua");
        self::$decalScript          = file_get_contents(__DIR__ . "/DecalScript.lua"); // missing, planning to use from internalscripts file
        self::$faceScript           = file_get_contents(__DIR__ . "/FaceScript.lua"); // missing, planning to use from internalscripts file
        self::$gearScript           = file_get_contents(__DIR__ . "/GearScript.lua");
        self::$headScript           = file_get_contents(__DIR__ . "/HeadScript.lua");
        self::$hatScript            = file_get_contents(__DIR__ . "/HatScript.lua"); // missing, planning to use from internalscripts file
        self::$mannequinUrl         = self::$assetRequest . self::$mannequinId . self::$accessKeyParameter;
        self::$modelScript          = file_get_contents(__DIR__ . "/ModelScript.lua");
        self::$packageScript        = file_get_contents(__DIR__ . "/PackageScript.lua"); // missing, planning to use from internalscripts file
        self::$pantsScript          = file_get_contents(__DIR__ . "/PantsScript.lua"); // missing, planning to reutilize from ShirtScript.lua
        self::$placeScript          = file_get_contents(__DIR__ . "/PlaceScript.lua");
        self::$scriptPngPath        = \Roblox\Common\Web::getApplicationURL() . "/Thumbs/Script.png";
        self::$shirtScript          = file_get_contents(__DIR__ . "/ShirtScript.lua");
        self::$toolPngPath          = \Roblox\Common\Web::getApplicationURL() . "/Thumbs/Tool.png";
        self::$url                  = \Roblox\Common\Web::getApplicationURL() . "/";
    }

    public static function getMrGrayId() {
        return self::$mannequinId;
    }
}

class BodyPartRequest {

    protected function getCustomTextureAssetId() {
        return -1;
    }

    protected function getScriptContent() {
        return Asset::$bodyPartScript;
    }

    public function requiresDeepModeration() {
        return false;
    }

    protected function getScript($size) {
        $customTextureUrl = Asset::$assetRequest . $this->getCustomTextureAssetId();
        return Lua::NewScript(
            $this->key,
            $this->getScriptContent(),
            $this->assetHashUrl,
            Asset::$url,
            $this->imageParameters->fileExtension,
            $size["width"],
            $size["height"],
            Asset::$mannequinUrl,
            $customTextureUrl
        );
    }
}

class ClothingRequest extends \Roblox\Grid\GridRequest {
    abstract protected function getScriptContent();

    protected function getCategory() {
        return \Roblox\Grid\JobCategory::FAST_JOB;
    }

    public function requiresDeepModeration() {
        return true;
    }

    protected function NewScript($size) {
        return Lua::newScript(
            $this->key,
            $this->getScriptContent(),
            $this->assetHashUrl,
            $this->imageParameters->fileExtension,
            $size["width"],
            $size["height"],
            Asset::$url
        );
    }
}
