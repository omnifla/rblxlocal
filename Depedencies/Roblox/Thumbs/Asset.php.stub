	class PackageRequest : GridRequest
	{
		private IAsset _Package;
		protected override JobCategory Category
		{
			get { return JobCategory.FastJob; }
		}
		public override bool RequiresDeepModeration
		{
			get { return false; }
		}
		public override string TypeIdentifier
		{
			get { return "Package"; }
		}
		protected static string script
		{
			get
			{
				if (!string.IsNullOrEmpty(Properties.Settings.Default.PackageScriptOverride))
					return Properties.Settings.Default.PackageScriptOverride;
				else
					return _PackageScript;
			}
		}
		public PackageRequest(IAsset package, ImageParameters imageParameters)
			: base(package.AssetHashID, imageParameters)
		{
			_Package = package;
		}
		protected override ScriptExecution GetScript(Size size)
		{
			string asseturls = string.Empty;
			string guyurl = string.Format("{0}/Asset/?id={1}&accesskey={2}", Common.Web.ApplicationURL, MrGrayID, Common.Web.AccessKey);
			string customtextureurls = string.Empty;
			bool shirtTextureAlreadyApplied = false;
			bool legsTextureAlreadyApplied = false;
			// This will loop through the packaged items and add the checkered texture for each one of them.
			List<AccoutrementPackageItem> packagedItems = (List<AccoutrementPackageItem>)AccoutrementPackageItem.GetAccoutrementPackageItems(_Package.CurrentVersion.AssetID);
			foreach (var asset in packagedItems)
			{
				// Add the asset to the list of assets
				asseturls += string.Format("{0}/Asset/?versionid={1};", Common.Web.ApplicationURL, asset.Asset.CurrentVersionID);
				// Get the blue checkered texture
				long customTextureId = 0;
				if (asset.AssetTypeID == AssetType.LeftArmID || asset.AssetTypeID == AssetType.RightArmID)
				{
					if (shirtTextureAlreadyApplied)
						continue;
					// See if there is a torso, if so, we need to use the full upper body texture, other wise just the two arm texture (assume always another arm)
					if (packagedItems.Find((a) => (a.AssetTypeID == AssetType.TorsoID)) != null)
						customTextureId = Properties.Settings.Default.FullUpperBodyShirtTextureAssetID;
					else
						customTextureId = Properties.Settings.Default.ArmsShirtTextureAssetID;
					shirtTextureAlreadyApplied = true;
				}
				else if (asset.AssetTypeID == AssetType.LeftLegID || asset.AssetTypeID == AssetType.RightLegID)
				{
					if (legsTextureAlreadyApplied)
						continue;
					customTextureId = Properties.Settings.Default.LegsPantsTextureAssetID;
					legsTextureAlreadyApplied = true;
				}
				else if (asset.AssetTypeID == AssetType.TorsoID)
				{
					if (shirtTextureAlreadyApplied)
						continue;
					// If a right arm exists it means a left arm exists (Requirement to Marketing team)
					// this also means that we're using the full upper body texture, otherwise just torso
					if (packagedItems.Find((e) => (a.AssetTypeID == AssetType.RightArmID)) != null)
						customTextureId = Properties.Settings.Default.FullUpperBodyShirtTextureAssetID;
					else
						customTextureId = Properties.Settings.Default.TorsoShirtTextureAssetID;
					shirtTextureAlreadyApplied = true;
				}
				if (customTextureId != 0)
					customtextureurls += string.Format("{0}/Asset/?id={1};", Common.Web.ApplicationURL, customTextureId);
			}
			return Lua.NewScript(
				Key,
				script,
				asseturls,
				_Url,
				ImageParameters.FileExtension,
				size.Width,
				size.Height,
				guyurl,
				customtextureurls
			);
		}
	}
