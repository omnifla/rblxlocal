	[WebMethod]
	[ScriptMethod(UseHttpGet = true)]
	public ScriptThumbResult RequestThumbnail(long assetId, long? assetVersionId, int? width, int? height, string imageFormat, int thumbnailFormatId, bool overrideModeration)
	{
		//If width and height passed as null, get from the thumbnail format
		if (!width.HasValue || !height.HasValue)
		{
			var thumbnailFormat = ThumbnailFormat.Get(thumbnailFormatId);
			width = thumbnailFormat.Width;
			height = thumbnailFormat.Height;
		}
		IAsset iAsset;
		if (assetVersionId.HasValue && (assetVersionId.Value != default(long)))
			iAsset = Roblox.AssetVersion.Get(assetVersionId.Value);
		else
			iAsset = Roblox.Asset.Get(assetId);
		var imageParameters = new ImageParameters(width.Value, height.Value, imageFormat, thumbnailFormatId);
		ThumbResult thumbResult = GetThumbnailUrl(iAsset, imageParameters, overrideModeration);
		var scriptThumbResult = new ScriptThumbResult(thumbResult, Context.Request.IsSecureConnection);
		return scriptThumbResult
	}
	[WebMethod]
	[ScriptMethod(UseHttpGet = true)]
	public ScriptThumbResult RequestThumbnail_v2(long assetId, long? assetVersionId, int? width, int? height, string imageFormat, int thumbnailFormatId, bool overrideModeration)
	{
		return RequestThumbnail(assetId, assetVersionId, width, height, imageFormat, thumbnailFormatId, overrideModeration);
	}
	private static AssetReference BuildAssetReference(IAsset asset)
	{
		var a = asset as Roblox.Asset;
		if (a != null)
			return new AssetReference(AssetReference.AssetReferenceTypes.AssetSubscription);
		var av = asset as Roblox.AssetVersion;
		if (av != null)
			return new AssetReference(AssetReference.AssetReferenceTypes.AssetVersion);
		var ua = asset as Roblox.UserAsset;
		if (ua != null)
			return new AssetReference(ua.GetAsset(), AssetReference.AssetReferenceTypes.AssetSubscription);
		throw new ArgumentException("Asset instance is not a valid IAsset.");
	}
	private static string GetAssetUrl(IAsset asset)
	{
		var a = asset as Roblox.Asset;
		if (a != null)
			return _AssetRequest + a.ID;
		var av = asset as Roblox.AssetVersion;
		if (av != null)
			return _AssetVersionRequest + av.ID;
		var ua = asset as Roblox.UserAsset;
		if (ua != null)
			return _AssetRequest + ua.AssetID;
		throw new ArgumentException("Asset instance is not a valid IAsset.");
	}
	private static ThumbResult GetUnapprovedThumbnailUrl(ImageParameters imageParameters)
	{
		return Dispatcher.Singleton.RequestUnapproved(imageParameters);
	}
	private static ThumbResult GetUnreviewedThumbnailUrl(ImageParameters imageParameters)
	{
		return Dispatcher.Singleton.RequestUnreviewed(imageParameters);
	}
	public static ThumbResult GetThumbnailUrl(IAsset asset, ImageParameters imageParameters)
	{
		return GetThumbnailUrl(asset, imageParameters, false);
	}
	public static ThumbResult GetThumbnailUrl(IAsset asset, ImageParameters imageParameters, bool overrideModeration)
	{
		try
		{
			if (asset == null)
				return Dispatcher.Singleton.RequestBroken(imageParameters);
			AssetType assetType = asset.Type;
			bool isApproved = asset.IsApproved;
			bool isReviewed = asset.IsReviewed;
			/*
			 *
			 *   Requires Review | Reviewed | Approved | Image          
			 *   ----------------+----------+----------+----------------
			 *          F        |     -    |    F     |  BAD!          
			 *          F        |     -    |    T     |  Good          
			 *          T        |     F    |    -     |  Pending Review
			 *          T        |     T    |    F     |  BAD!
			 *          T        |     T    |    T     |  Good
			 *
			 */
			if (!Account.IsCurrentAccountInRole("RBXModerators") && !overrideModeration)
			{
				if (!isApproved && (isReviewed || !assetType.RequiresReview))
					return GetUnapprovedThumbnailUrl(imageParameters);
				if (!isReviewed && assetType.RequiresReview)
					return GetUnreviewedThumbnailUrl(imageParameters);
			}
			int assetTypeId = assetType.ID;
			ThumbnailRequest thumbnailRequest;
			if (assetTypeId == AssetType.ImageID)
				thumbnailRequest = new ImageRequest(asset.AssetHashID, imageParameters);
			else if (assetTypeId == AssetType.BadgeID)
				thumbnailRequest = new BadgeRequest(asset, imageParameters);
			else if (assetTypeId == AssetType.DecalID)
				thumbnailRequest = new DecalRequest(asset.AssetHashID, imageParameters);
			else if (assetTypeId == AssetType.HatID)
				thumbnailRequest = new HatRequest(asset.AssetHashID, imageParameters);
			else if (assetTypeId == AssetType.HeadID)
				thumbnailRequest = new HeadRequest(asset.AssetHashID, imageParameters);
			else if (assetTypeId == AssetType.FaceID)
				thumbnailRequest = new FaceRequest(asset.AssetHashID, imageParameters);
			else if (assetTypeId == AssetType.GearID)
				thumbnailRequest = new GearRequest(asset.AssetHashID, imageParameters);
			else if (assetTypeId == AssetType.ModelID)
				thumbnailRequest = new ModelRequest(asset.AssetHashID, imageParameters);
			else if (assetTypeId == AssetType.PantsID)
				thumbnailRequest = new PantsRequest(asset.AssetHashID, imageParameters);
			else if (assetTypeId == AssetType.PlaceID)
				thumbnailRequest = new PlaceRequest(asset.AssetHashID, imageParameters);
			else if (assetTypeId == AssetType.ShirtID)
				thumbnailRequest = new ShirtRequest(asset.AssetHashID, imageParameters);
			else if (assetTypeId == AssetType.TeeShirtID)
				thumbnailRequest = new TeeShirtRequest(asset, imageParameters);
			else if (assetTypeId == AssetType.ArmsID)
				thumbnailRequest = new ArmsRequest(asset.AssetHashID, imageParameters);
			else if (assetTypeId == AssetType.LeftArmID)
				thumbnailRequest = new LeftArmRequest(asset.AssetHashID, imageParameters);
			else if (assetTypeId == AssetType.RightArmID)
				thumbnailRequest = new RightArmRequest(asset.AssetHashID, imageParameters);
			else if (assetTypeId == AssetType.LegsID)
				thumbnailRequest = new LegsRequest(asset.AssetHashID, imageParameters);
			else if (assetTypeId == AssetType.LeftLegID)
				thumbnailRequest = new LeftLegRequest(asset.AssetHashID, imageParameters);
			else if (assetTypeId == AssetType.RightLegID)
				thumbnailRequest = new RightLegRequest(asset.AssetHashID, imageParameters);
			else if (assetTypeId == AssetType.TorsoID)
				thumbnailRequest = new TorsoRequest(asset.AssetHashID, imageParameters);
			else if (assetTypeId == AssetType.PackageID)
				thumbnailRequest = new PackageRequest(asset, imageParameters);
			else if (assetTypeId == AssetType.AudioID)
				thumbnailRequest = new StaticImageRequest(imageParameters, Resources.AudioThumbnail, "Audio") { PreserveAspectRatio = true };
			//thumbnailRequest = new StaticImageRequest(imageParameters, "~/thumbs/audio.png", "Audio") {PreserveAspectRatio = true };
			else if (assetTypeId == AssetType.LuaID)
				thumbnailRequest = new StaticImageRequest(imageParameters, Resources.ScriptThumbnail, AssetType.LuaValue) { PreserveAspectRatio = true };
			//thumbnailRequest = new StaticImageRequest(imageParameters, "~/thumbs/script.png", AssetType.LuaValue) {PreserveAspectRatio = true };
			else
				thumbnailRequest = new StaticImageRequest(imageParameters, Resources.UnknownThumbnail, "Unknown") { PreserveAspectRatio = true };
			//thumbnailRequest = new StaticImageRequest(imageParameters, "~/thimbs/unknown.png", "Unknown") {PreserveAspectRatio = true };
			return Dispatcher.Singleton.RequestThumbnail(thumbnailRequest);
		}
		catch (Exception ex)
		{
			ExceptionHandler.LogException(ex);
			if (Roblox.GlobalProperties.IsTestingSite)
				throw ex;
			return Dispatcher.Singleton.RequestBroken(imageParameters);
		}
	}
	#region IHttpHandler Members
	public bool IsReusable
	{
		get { return true; }
	}
	public void ProcessRequest(HttpContext context)
	{
		HttpRequest request = context.Request;
		var queryString = request.QueryString;
		IAsset thumbAsset = null;
		long assetId = default(long);
		string id_str = queryString["userassetid"];
		if (!string.IsNullOrEmpty(id_str))
		{
			long id = Convert.ToInt64(id_str);
			var userAsset = UserAsset.Get(id);
			thumbAsset = userAsset.CurrentVersion;
		}
		else
		{
			id_str = queryString["assetversion"];
			if (!string.IsNullOrEmpty(id_str))
			{
				long id = Convert.ToInt64(id_str);
				var assetVersion = AssetVersion.Get(id);
				assetId = assetVersion.AssetID;
				thumbAsset = assetVersion;
			}
			else
			{
				id_str = queryString["assetid"];
				if (!string.IsNullOrEmpty(id_str) && (id_str != "undefined"))
				{
					assetId = Convert.ToInt64(id_str);
					var asset = Roblox.Asset.Get(assetId);
					thumbAsset = asset.CurrentVersion;
				}
			}
		}
		int thumbAssetTypeId = thumbAsset.Type.ID;
		// Unfortunately, if it's a mesh, image, or sound, we need to let them access it for thumbnailing.
		// If it's a gear item, hat, or face however, we can restrict access...
		if (
			(
				(thumbAssetTypeId == AssetType.GearID)
				|| (thumbAssetTypeId == AssetType.HatID)
				|| (thumbAssetTypeId == AssetType.FaceID)
			)
			&& (DelayedReleaseAsset.IsDelayedAsset(assetId))
		)
		{
			var authenticatedUser = Roblox.User.GetCurrent(context);
			if (
				(authenticatedUser == null)
				|| !authenticatedUser.TestIsAdministrator()
			)
			{
				context.Response.StatusCode = 500;
				return;
			}
		}
		var imageParameters = new ImageParameters(request);
		ThumbResult thumbResult = GetThumbnailUrl(thumbAsset, imageParameters);
		string url = thumbResult.GetUrl(request.IsSecureConnection);
		context.Response.Redirect(url, false);
	}
	#endregion
}
