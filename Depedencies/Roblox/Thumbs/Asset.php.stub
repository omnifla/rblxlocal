			: base(assetHashId, imageParameters)
		{
		}
		internal override Bitmap GenerateBitmap(ref ICollection<AssetReference> assetReferences)
		{
			var scaledBitmap = new Bitmap(ImageParameters.Width, ImageParameters.Height, PixelFormat.Format32bppArgb);
			using (MemoryStream memoryStream = FilesManager.Singleton.GetStream(AssetHash))
			{
				using (var image = Image.FromStream(memoryStream))
				{
					Thumbnails.DrawInto(image, scaledBitmap);
				}
			}
			return scaledBitmap;
		}
	}
	class StaticImageRequest : ThumbnailRequest
	{
		private Bitmap _Bitmap;
		private string _TypeIdentifier;
		protected override string InstanceIdentifier
		{
			get { return "000000000000000000000000000000000"; }
		}
		public bool PreserveAspectRatio = false;
		public override bool RequiresDeepModeration
		{
			get { return false; }
		}
		public override string TypeIdentifier
		{
			get { return _TypeIdentifier; }
		}
		public StaticImageRequest(ImageParameters imageParameters, Bitmap bitmap, string typeIdentifier)
			: base(Roblox.AssetHash.GetOrCreate(AssetType.ImageID, typeIdentifier, Roblox.User.RobloxAccount).ID, imageParameters)
		{
			_TypeIdentifier = typeIdentifier;
			_Bitmap = bitmap;
		}
		internal override Bitmap GenerateBitmap(ref ICollection<AssetReference> assetReferences)
		{
			var scaledBitmap = new Bitmap(ImageParameters.Width, ImageParameters.Height, PixelFormat.Format32bppArgb);
			if (PreserveAspectRatio)
			{
				Thumbnails.DrawInto(_Bitmap, scaledBitmap);
			}
			else
			{
				using (var graphics = Graphics.FromImage(scaledBitmap))
				{
					graphics.InterpolationMode = InterpolationMode.HighQualityBicubic;
					graphics.DrawImage(_Bitmap, 0, 0, ImageParameters.Width, ImageParameters.Height);
				}
			}
			return scaledBitmap;
		}
	}
	class TeeShirtRequest : ThumbnailRequest
	{
		private Roblox.IAsset _TeeShirt;
		public override bool RequiresDeepModeration
		{
			get { return true; }
		}
		public override string TypeIdentifier
		{
			get { return "TeeShirt"; }
		}
		//private static string _TeeShirtFile = HostingEnvironment.MapPath("~/App_Data/tshirt.png");
		public TeeShirtRequest(IAsset teeShirt, ImageParameters imageParameters)
			: base(teeShirt.AssetHashID, imageParameters)
		{
			_TeeShirt = teeShirt;
		}
		internal override Bitmap GenerateBitmap(ref ICollection<AssetReference> assetReferences)
		{
			var teeShirtDocument = new XmlDocument();
			using (MemoryStream teeShirtMemoryStream = FilesManager.Singleton.GetStream(AssetHash))
			{
				teeShirtDocument.Load(teeShirtMemoryStream);
			}
			AssetReference teeShirtImageAssetReference = TeeShirt.GetImageAssetReference(teeShirtDocument);
			assetReferences.Add(teeShirtImageAssetReference);
			// Overlay the graphic inside the TeeShirt
			RectangleF teeShirtBox;
			var scaledBitmap = new Bitmap(ImageParameters.Width, ImageParameters.Height, PixelFormat.Format32bppArgb);
			teeShirtBox = Thumbnails.DrawInto(Resources.TeeShirtThumbnail, scaledBitmap);
			//using (var teeShirtImage = Image.FromFile(_TeeShirtFile))
			//{
			//    teeShirtBox = Thumbnails.DrawInto(teeShirtImage, scaledBitmap);
			//}
			IAsset teeShirtImageAsset = teeShirtImageAssetReference.ReferredAsset;
			bool isReviewed = teeShirtImageAsset.IsReviewed;
			bool isApproved = _TeeShirt.IsApproved && teeShirtImageAsset.IsApproved;
			if (isReviewed && isApproved)
			{
				teeShirtBox.Inflate(-0.2f * teeShirtBox.Width, -0.2f * teeShirtBox.Height);
				using (var image = TeeShirt.GetImage(teeShirtDocument))
				{
					Thumbnails.DrawInto(image, scaledBitmap, teeShirtBox);
				}
			}
			else if (!isReviewed)
			{
				teeShirtBox.Inflate(-0.2f * teeShirtBox.Width, -0.2f * teeShirtBox.Height);
				using (var Bitmap bitmap = Dispatcher.Singleton.CreatePendingReviewBitmap(ImageParameters.Width, ImageParameters.Height))
				{
					Thumbnails.DrawInto(image, scaledBitmap, teeShirtBox);
				}
			}
			else if (!isApproved)
			{
				teeShirtBox.Inflate(-0.2f * teeShirtBox.Width, -0.2f * teeShirtBox.Height);
				using (var Bitmap bitmap = Dispatcher.Singleton.CreateUnapprovedBitmap(ImageParameters.Width, ImageParameters.Height))
				{
					Thumbnails.DrawInto(image, scaledBitmap, teeShirtBox);
				}
			}
			return scaledBitmap;
		}
	}
