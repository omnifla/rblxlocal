<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <defaultDocument enabled="true" />
        <rewrite>
            <rules>
			<rule name="FetchCSS" stopProcessing="true">
          <match url="^CSS/Base/CSS/FetchCSS$" />
          <action type="Rewrite" url="/CSS/Base/CSS/FetchCSS.php" />
        </rule>
                <!-- Rewrite .php extension -->
                <rule name="Hide .php ext">
                    <match url="^(.*)" ignoreCase="true" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                        <add input="{REQUEST_FILENAME}.php" matchType="IsFile" />
                        <!-- Exclude specific file types, including .data -->
                        <add input="{REQUEST_URI}" pattern="^.*\.(html|js|css|jpg|png|gif|bin|txt|json)$" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="{R:0}.php" />
                </rule>

                <!-- Redirect .php to clean URL -->
                <rule name="Redirecting .php ext" stopProcessing="true">
                    <match url="^(.*).html" />
                    <conditions logicalGrouping="MatchAny">
                        <add input="{URL}" pattern="(.*).php" />
                    </conditions>
                    <action type="Redirect" url="{R:1}" />
                </rule>
            </rules>
        </rewrite>
        
        <httpErrors errorMode="Detailed" />

        <!-- Add MIME type for .data files -->
        <staticContent>
            <mimeMap fileExtension=".data" mimeType="application/octet-stream" />
        </staticContent>

    </system.webServer>
</configuration>
