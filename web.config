<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <defaultDocument>
            <files>
                <add value="index.php" />
            </files>
        </defaultDocument>
        <rewrite>
            <rules>
                <rule name="UserAdsTypeRewrite" stopProcessing="true">
                    <match url="^userads/([123])$" ignoreCase="true" />
                    <action type="Rewrite" url="userads/index.php?type={R:1}" />
                </rule>
                <rule name="NoPHP" stopProcessing="true">
                    <match url="^([a-zA-Z0-9_\-/]+)$" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}.php" matchType="IsFile" />
                    </conditions>
                    <action type="Rewrite" url="{R:1}.php" />
                </rule>
                <rule name="UserAdsInvalid" stopProcessing="true">
                    <match url="^userads/([0-9]+)$" />
                    <conditions>
                        <add input="{R:1}" pattern="^(?![123]$).*$" />
                    </conditions>
                    <action type="Redirect" url="/RobloxDefaultErrorPage.aspx?code=404" redirectType="Found" />
                </rule>
            </rules>
        </rewrite>
        <!-- <system.web>
            <customErrors mode="On" defaultRedirect="/RobloxDefaultErrorPage.aspx">
              <error statusCode="404" redirect="/RobloxDefaultErrorPage.aspx?code=404" />
              <error statusCode="500" redirect="/RobloxDefaultErrorPage.aspx?code=500" />
              <error statusCode="403" redirect="/RobloxDefaultErrorPage.aspx?code=403" />
            </customErrors>
          </system.web> -->
    </system.webServer>
</configuration>
